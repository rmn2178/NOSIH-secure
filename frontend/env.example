# Frontend-only environment.
#
# CRA reads frontend/.env.local (or frontend/.env) and inlines every
# REACT_APP_* value into the production bundle at BUILD time.
#
# This is the only file that stays separate from the root .env — the backend
# and the deployment scripts all read the root .env.
#
# In production the SPA calls same-origin /api, so REACT_APP_API_URL is not
# needed. Both values are optional.

# Leave unset to use the CRA dev proxy (http://localhost:3000/api).
# REACT_APP_API_URL=http://localhost:5000/api

# Transaction links in the registrar portal.
REACT_APP_TX_EXPLORER_URL=https://amoy.polygonscan.com/tx
