# ═══════════════════════════════════════════════════════════════
# NOSIH — copy this file to .env in the repository root and fill it in.
#
# This is the only environment file. The backend resolves it from its own
# module location (backend/env.js), so it is read no matter which
# directory you start the process from. The frontend keeps its own
# frontend/.env.local for REACT_APP_* values, which are inlined into the
# production bundle at build time.
#
# On Vercel there is no .env file — the platform injects the variables
# instead. Use `npm run vercel:env` to push this file to the project.
#
# Never commit .env.
# ═══════════════════════════════════════════════════════════════

# ── Blockchain (Polygon Amoy) ──────────────────────────────
# ALCHEMY_AMOY_URL is checked first — set it when you have an Alchemy key.
# Until then AMOY_RPC_URL is used.
ALCHEMY_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# Existing LandRegistry deployment on Polygon Amoy
CONTRACT_ADDRESS=0xYourLandRegistryAddress

# Informational only — hardhat.config.js pins Amoy=80002, Polygon=137
CHAIN_ID=80002

# Registrar wallet that signs registerRecord / revokeRecord.
# MUST be authorised on the contract (npm run issuer:add) and hold POL for gas.
ISSUER_PRIVATE_KEY=YOUR_REGISTRAR_PRIVATE_KEY_WITHOUT_0x

# ── Hardhat deployment keys (local only) ────────────────────
# Owner wallet — pays gas for deploy, and is the only account that can
# add or remove registrars.
DEPLOYER_PRIVATE_KEY=YOUR_OWNER_PRIVATE_KEY_WITHOUT_0x

# Derived from ISSUER_PRIVATE_KEY (verify with scripts/check-env.js)
ISSUER_ADDRESS=0xIssuerWalletAddress

# Optional — for contract source verification on polygonscan
POLYGONSCAN_API_KEY=

# ── Land registry secrets ──────────────────────────────────
# 64 hex chars each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACK THESE UP. Losing DOCUMENT_ENC_KEY makes every stored deed unreadable;
# changing HASH_PEPPER changes every Land ID so new deeds stop linking to old ones.
DOCUMENT_ENC_KEY=
HASH_PEPPER=

# ── Database (Supabase) ───────────────────────────────────
# 1. Create a project at https://supabase.com
# 2. Run backend/supabase/schema.sql in the SQL editor
# 3. Copy the URL and service_role key from Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── IPFS (Pinata) ─────────────────────────────────────────
# Either a JWT, or API key + secret. The backend prefers the JWT whenever
# one is set, so only enable a token that `npm run check:jwt` accepts.
PINATA_JWT=YOUR_PINATA_JWT
PINATA_API_KEY=
PINATA_API_SECRET=

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=8h

# ── App (local only — not deployed to Vercel) ──────────────
PORT=5000
NODE_ENV=development
BACKEND_PUBLIC_URL=http://localhost:5000
VERIFY_BASE_URL=http://localhost:3000/verify
FRONTEND_URL=http://localhost:3000
IPFS_GATEWAY_BASE_URL=https://gateway.pinata.cloud/ipfs

# Upload cap in MB. Defaults to 15 locally and 4 on Vercel (4.5 MB body limit).
# Only set this to override.
# MAX_UPLOAD_MB=15

# Who may open the decrypted deed from the public verify page:
#   registrar (default) — requires a registrar JWT
#   public             — anyone with the Land ID (deeds become public)
VIEW_DOCUMENT_POLICY=registrar

# ── AI (Google Gemini) ────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Options: gemini-3.6-flash (recommended) | gemini-3.8-flash (hangs) | gemini-3-flash-preview
GEMINI_MODEL=gemini-3.6-flash

# ── Admin bootstrap (npm run seed:admin) ──────────────────
ADMIN_EMAIL=admin@nosih.com
ADMIN_PASSWORD=ChangeThisPassword123!
