# Blockchain (Polygon Amoy)
ALCHEMY_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CONTRACT_ADDRESS=0xYourLandRegistryAddress
CHAIN_ID=80002

# Registrar wallet that signs registerRecord / revokeRecord (must be added via addRegistrar)
ISSUER_PRIVATE_KEY=YOUR_REGISTRAR_PRIVATE_KEY_WITHOUT_0x

# Land registry secrets — 64 hex chars each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACK THESE UP. Losing DOCUMENT_ENC_KEY makes every stored deed unreadable;
# changing HASH_PEPPER changes every Land ID so new deeds stop linking to old ones.
DOCUMENT_ENC_KEY=
HASH_PEPPER=

# Database (Supabase)
# 1. Create a project at https://supabase.com
# 2. Run backend/supabase/schema.sql in the SQL editor
# 3. Copy the URL and service_role key from Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# IPFS (Pinata)
PINATA_JWT=YOUR_PINATA_JWT
PINATA_API_KEY=
PINATA_API_SECRET=

# Auth
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=8h

# App
PORT=5000
NODE_ENV=development
BACKEND_PUBLIC_URL=http://localhost:5000
VERIFY_BASE_URL=http://localhost:3000/verify
FRONTEND_URL=http://localhost:3000
IPFS_GATEWAY_BASE_URL=https://gateway.pinata.cloud/ipfs

# AI (Google Gemini)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Options: gemini-3.6-flash (recommended) | gemini-3.8-flash (hangs) | gemini-3-flash-preview
GEMINI_MODEL=gemini-3.6-flash

# Admin bootstrap
ADMIN_EMAIL=admin@nosih.com
ADMIN_PASSWORD=ChangeThisPassword123!
